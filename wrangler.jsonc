{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "udjog-c2c",
	"main": "src/index.js",
	"compatibility_date": "2024-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Static Assets Binding (Serves all frontend HTML, CSS, JS, Images)
	"assets": {
		"directory": "./",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "single-page-application"
	},
	// Cloudflare D1 Database Binding
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "udjog_db",
			"database_id": "5acf068f-3f29-4dc4-b630-a4e6bf87f497"
		}
	],
	"vars": {
		"ADMIN_PASSWORD": "udjog202",
		"ENVIRONMENT": "production"
	}
}